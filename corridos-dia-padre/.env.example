# Copia este archivo a ".env" y rellena tus valores reales.
# NUNCA pongas tu API key real aqui: este archivo SI se sube al repositorio.
# La clave real va SOLO en tu archivo ".env" (que esta en .gitignore).

# URL base del endpoint compatible con OpenAI (incluye /v1).
# Ejemplos:
#   https://api.openai.com/v1
#   https://api.freemodel.dev/v1   (FreeModel, formato OpenAI)
FREEMODEL_BASE_URL=https://api.freemodel.dev/v1

# Tu clave de API. Se lee SOLO desde esta variable de entorno.
FREEMODEL_API_KEY=tu-api-key-aqui

# Identificador del modelo a usar.
# Ejemplos FreeModel: gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-5.3-codex
FREEMODEL_MODEL=gpt-5.4-mini
