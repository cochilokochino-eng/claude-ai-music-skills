# Copia este archivo a ".env" y rellena tus valores reales.
# NUNCA subas tu archivo .env real al repositorio.

# URL base del endpoint compatible con OpenAI (sin la ruta /chat/completions).
# Ejemplos:
#   https://api.openai.com/v1
#   https://tu-proveedor.com/v1
FREEMODEL_BASE_URL=https://api.freemodel.dev

# Tu clave de API. Se lee SOLO desde esta variable de entorno.
FREEMODEL_API_KEY=fe_oa_b8209b96b198f3f3b9a6017787f3ba41a197f7e9773cc2b4

# Identificador del modelo a usar.
# Ejemplos: gpt-4o-mini, gpt-4o, llama-3.1-70b-instruct, etc.
FREEMODEL_MODEL=fre-5.5
